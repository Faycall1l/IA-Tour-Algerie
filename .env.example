# Database (ATHAR Postgres on 5434; user/password from docker-compose override)
DATABASE__URL=postgresql+asyncpg://athar:athar_pass@localhost:5434/athar_db?sslmode=disable

# Qdrant (API key optional for local dev)
QDRANT__HOST=localhost
QDRANT__PORT=6333
QDRANT__API_KEY=

# Redis (password required)
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__PASSWORD=redispass

# MinIO (ATHAR instance on 19000, isolated from meddata's 9000)
MINIO__ENDPOINT=localhost:19000
MINIO__PUBLIC_URL=http://localhost:19000/athar-uploads
MINIO__ACCESS_KEY=minioadmin
MINIO__SECRET_KEY=minioadmin

# Auth — Ed25519 private key in PEM. If empty, one is generated and
# persisted to secrets/jwt_ed25519.pem (gitignored) so tokens survive restarts.
AUTH__JWT_PRIVATE_KEY=
AUTH__JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH__JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Twilio (optional for now)
TWILIO__ACCOUNT_SID=
TWILIO__AUTH_TOKEN=
TWILIO__VERIFY_SERVICE_SID=

# App
DEBUG=false
