# Database (password stored in Docker secret, not here)
DATABASE__URL=postgresql+asyncpg://athar:athar_pass@localhost:5432/athar_db?sslmode=disable

# Qdrant (API key optional for local dev)
QDRANT__HOST=localhost
QDRANT__PORT=6333
QDRANT__API_KEY=

# Redis (password required)
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__PASSWORD=redispass

# MinIO
MINIO__ENDPOINT=localhost:9000
MINIO__ACCESS_KEY=minioadmin
MINIO__SECRET_KEY=minioadmin

# Auth — Ed25519 private key in PEM (generate with: openssl genpkey -algorithm ed25519 -out private.pem)
# If empty, one is generated at startup (tokens invalidated on restart)
AUTH__JWT_PRIVATE_KEY=
AUTH__JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH__JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Twilio (optional for now)
TWILIO__ACCOUNT_SID=
TWILIO__AUTH_TOKEN=
TWILIO__VERIFY_SERVICE_SID=

# App
DEBUG=false
