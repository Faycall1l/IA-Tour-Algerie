# Database (ATHAR Postgres on 5434; user/password from docker-compose override)
ATHAR_DATABASE__URL=postgresql+asyncpg://athar:athar_pass@localhost:5434/athar_db?sslmode=disable

# Qdrant (API key optional for local dev; REST preferred over gRPC from the host)
ATHAR_QDRANT__HOST=localhost
ATHAR_QDRANT__PORT=6333
ATHAR_QDRANT__PREFER_GRPC=false
ATHAR_QDRANT__API_KEY=

# Redis — docker-compose override publishes the container on 6381 to avoid
# clashing with the host's 6379 (often held by a tunnel/other project).
# Container runs with no requirepass, so leave PASSWORD empty.
ATHAR_REDIS__HOST=localhost
ATHAR_REDIS__PORT=6381
ATHAR_REDIS__PASSWORD=

# MinIO (ATHAR instance on 19000, isolated from meddata's 9000)
ATHAR_MINIO__ENDPOINT=localhost:19000
ATHAR_MINIO__PUBLIC_URL=http://localhost:19000/athar-uploads
ATHAR_MINIO__ACCESS_KEY=minioadmin
ATHAR_MINIO__SECRET_KEY=minioadmin

# Auth — Ed25519 private key in PEM. If empty, one is generated and
# persisted to secrets/jwt_ed25519.pem (gitignored) so tokens survive restarts.
ATHAR_AUTH__JWT_PRIVATE_KEY=
ATHAR_AUTH__JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
ATHAR_AUTH__JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Twilio (optional for now)
ATHAR_TWILIO__ACCOUNT_SID=
ATHAR_TWILIO__AUTH_TOKEN=
ATHAR_TWILIO__VERIFY_SERVICE_SID=

# App
# Debug mode: enables /docs, /openapi.json, and the fixed dev OTP below.
# NEVER enable in production.
ATHAR_DEBUG=false
# Frontend origin used to build absolute deep links on agent replies
# (e.g. https://athar.app). Empty → links stay relative to the client origin.
ATHAR_APP_URL=
# Fixed OTP accepted by /auth/verify-otp only when ATHAR_DEBUG=true — lets local
# frontends sign in without Twilio SMS. Ignored in production.
ATHAR_DEBUG_OTP=000000

# Host allowlist (JSON array). Defaults to loopback only — set this in
# deployment. NOTE: list values are parsed as JSON, not comma-separated.
ATHAR_ALLOWED_HOSTS=["localhost", "127.0.0.1"]
